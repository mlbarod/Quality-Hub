# OpenWebUI Chat Completions API 설정
# OPENWEBUI_URL에는 OpenWebUI 기본 URL을 입력합니다. /api 경로는 Client가 보완합니다.
OPENWEBUI_URL=
OPENWEBUI_MODEL=gpt-oss-120b
OPENWEBUI_API_TOKEN=

# 선택 설정: 공통 HTTP Header JSON, 호출 timeout(초), 향후 요약 처리용 batch 크기
OPENWEBUI_COMMON_HEADERS={}
OPENWEBUI_TIMEOUT_SECONDS=120
OPENWEBUI_SUMMARY_BATCH_SIZE=10
