# 즉시 롤백 스위치: false이면 SSO 코드가 없는 기존 동작을 유지한다.
SSO_ENABLED=false

# 개발: https://stsds-dev.secsso.net/adfs/oauth2/authorize/
# 운영: https://stsds.secsso.net/adfs/oauth2/authorize/
SSO_AUTHORIZE_URL=https://stsds-dev.secsso.net/adfs/oauth2/authorize/
SSO_SIGNOUT_URL=https://stsds-dev.secsso.net/adfs/ls/?wa=wsignoutcleanup1.0
SSO_CLIENT_ID=
SSO_REDIRECT_URI=https://quality-hub.example.internal/auth/callback
SSO_CERTIFICATE_PATH=/run/secrets/quality-hub/stsds-dev.secsso.net.cer

# openssl rand -base64 48 등으로 새로 생성하며 소스/채팅/로그에 남기지 않는다.
SSO_SESSION_SECRET=

# 최초 Claim 확인 1회만 true. 이 모드에서는 세션을 만들지 않고 Claim 키/자료형만 서버 로그에 남긴다.
SSO_SAFE_CLAIM_TRACE=true
SSO_EXPECTED_ISSUER=
SSO_USER_ID_CLAIM=
SSO_DISPLAY_NAME_CLAIM=
SSO_DEPARTMENT_CLAIM=

# 마스터 테이블이 비어 있을 때만 최초 1회 반영된다. 쉼표로 여러 ID를 구분한다.
SSO_BOOTSTRAP_MASTER_USER_IDS=

# 사내 규정이 없어서 적용한 보수적 기본값. 필요할 때만 변경한다.
SSO_LOGIN_TRANSACTION_SECONDS=300
SSO_SESSION_IDLE_SECONDS=1800
SSO_SESSION_ABSOLUTE_SECONDS=28800
SSO_CLOCK_TOLERANCE_SECONDS=60
SSO_SECURE_COOKIES=true
