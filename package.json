{
  "name": "quality-hub",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node server.mjs",
    "dev": "node server.mjs --source",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "start:static": "npm run build && node server.mjs",
    "rag:search": "node --env-file-if-exists=.env.rag scripts/rag-search.mjs",
    "rag:index": "node --env-file-if-exists=.env.rag scripts/rag-index.mjs",
    "rag:document:add": "node --env-file-if-exists=.env.rag scripts/rag-document-add.mjs",
    "rag:document:delete": "node --env-file-if-exists=.env.rag scripts/rag-document-delete.mjs",
    "gpt-oss:chat": "node --env-file-if-exists=.env.gpt-oss scripts/gpt-oss-chat.mjs",
    "db:history:check": "node --env-file-if-exists=.env.db scripts/db-history-check.mjs",
    "db:reports:check": "node --env-file-if-exists=.env.db scripts/db-reports-check.mjs",
    "backend:chat:check": "node --env-file-if-exists=.env.rag --env-file-if-exists=.env.gpt-oss --env-file-if-exists=.env.db scripts/backend-chat-check.mjs",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs && vitest run"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.2.6",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-select": "^2.3.7",
    "@radix-ui/react-slot": "^1.3.3",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@tiptap/extension-image": "^3.29.2",
    "@tiptap/extension-link": "^3.29.2",
    "@tiptap/extension-placeholder": "^3.29.2",
    "@tiptap/extension-table": "^3.29.2",
    "@tiptap/pm": "^3.29.2",
    "@tiptap/react": "^3.29.2",
    "@tiptap/starter-kit": "^3.29.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.28.0",
    "mysql2": "^3.23.2",
    "openai": "^7.4.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@vitejs/plugin-react": "^6.0.5",
    "axe-core": "^4.12.1",
    "jsdom": "^29.0.1",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
