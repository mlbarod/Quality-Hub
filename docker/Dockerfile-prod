FROM artifactory.samsungds.net/devops-template-ahub-docker/baseimage/node:22-py3.10 AS dependencies

USER root
WORKDIR /opt/work
COPY package.json package-lock.json ./
RUN npm ci

FROM dependencies AS build

ARG VITE_QNA_LINE_CATEGORIES=""
ENV VITE_QNA_LINE_CATEGORIES=${VITE_QNA_LINE_CATEGORIES}

COPY prototype ./prototype
COPY prototype/.env.local ./prototype/.env.local
COPY vite.config.mjs jsconfig.json components.json ./
RUN npm run build

FROM artifactory.samsungds.net/devops-template-ahub-docker/baseimage/node:22-py3.10 AS runtime

ENV NODE_ENV=production \
    HOST=0.0.0.0 \
    PORT=8080

USER root
WORKDIR /opt/work
COPY package.json package-lock.json ./
RUN npm ci --omit=dev && npm cache clean --force

COPY --chown=node\:node server.mjs ./
COPY --chown=node\:node server ./server
COPY --chown=node\:node --from=build /opt/work/dist ./dist

COPY --chown=node\:node .env.db ./
COPY --chown=node\:node .env.rag ./
COPY --chown=node\:node .env.gpt-oss ./

USER node
EXPOSE 8080

CMD ["node", "server.mjs"]